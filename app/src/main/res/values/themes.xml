<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns the visual theme; this platform theme only covers process startup and system bars. -->
    <style name="Theme.FlareDo" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/flare_window_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
